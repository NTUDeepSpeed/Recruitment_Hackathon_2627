# The build context is the repository root, and almost none of it belongs in
# the image. Keeping it small matters most in CI, where the context is
# uploaded to the builder on every run.

.git
.github
.gitmodules

docs
workshop
results
scripts

race_ws/build
race_ws/install
race_ws/log
race_ws/src/roboracer_baselines
race_ws/src/roboracer_referee
workshop/ros2_ws/build
workshop/ros2_ws/install
workshop/ros2_ws/log

**/__pycache__
**/*.pyc
docker/.env
docker/.x11-placeholder

# Kept on purpose, because the Dockerfile copies them:
#   external/f1tenth_gym, external/f1tenth_gym_ros   (simulator sources)
#   maps/                                            (the circuit)
#   docker/entrypoint.sh                             (shell setup)
#   race_ws/src/team_driver/*.txt                    (declared dependencies)
**/.git
