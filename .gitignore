# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- ROS / colcon ---
race_ws/build/
race_ws/install/
race_ws/log/
workshop/ros2_ws/build/
workshop/ros2_ws/install/
workshop/ros2_ws/log/

# --- AutoDRIVE Simulator ---
# ~140 MB of Unity binary per platform, fetched by scripts/fetch_simulator.sh.
# Never committed; the fetch script re-downloads it and verifies the size.
simulator/*
!simulator/.gitkeep
!simulator/README.md

# --- Docker helper state, written by install/<os>/run.sh ---
docker/.env
docker/.x11-placeholder/

# --- Evaluation output ---
# Keep the folder, ignore the runs. Commit a result only if asked to.
results/*
!results/.gitkeep
!results/README.md

# --- Recordings ---
*.bag
rosbag2_*/

# Written by the CI integrity step if it is ever run inside the checkout
integrity.txt
